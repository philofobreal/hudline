{
  "name": "hudline",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-free TypeScript library for animated HUD-style frames and rings on existing DOM elements.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rules": "node scripts/check-rules.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "check": "npm run typecheck && npm run rules && npm test",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "perf": "npm run build && node scripts/perf.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
